# .env - the settings most people change. After editing run:  docker compose up -d
# (use  docker compose up -d --build  only when program files were changed)

# The port employees use in the browser (plain http):  http://SERVER-IP:PORT
PORTAL_PORT=8000

# Your time zone, so times in the portal are correct.
# Examples: Asia/Dhaka   Europe/London   America/New_York   (list: timedatectl list-timezones)
TZ=UTC

# Reminder notifications (meetings, warranty ends ...) go to the bell from this hour of the
# day (24-hour clock, in the TZ above). 7 = from 07:00 in the morning.
REMINDER_HOUR=7

# ---------------------------------------------------------------------------
# OPTIONAL EXTRAS. Which of them run is set in COMPOSE_PROFILES:
#   COMPOSE_PROFILES=https          -> HTTPS front door
#   COMPOSE_PROFILES=scan           -> virus scanning of attachments
#   COMPOSE_PROFILES=https,scan     -> both
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=

# --- HTTPS (see README section 14). When you use it, also set the next 3 lines to the values shown:
PORTAL_HTTPS=0                 # set to 1
PORTAL_BEHIND_PROXY=0          # set to 1
PORTAL_BIND=0.0.0.0            # set to 127.0.0.1 (closes the plain http port to the network)
PORTAL_HOST=portal.hrctech.net # the name (or IP) employees type in the browser
HTTPS_PORT=443                 # the https port employees use (443 = no port needed in the address)
TLS_ARGS=internal              # internal = Caddy makes its own certificate
                               # or: /certs/portal.crt /certs/portal.key  (your own certificate)

# --- Virus scanning (see README section 15). When you use it, set this line:
CLAMAV_HOST=                   # set to: clamav
